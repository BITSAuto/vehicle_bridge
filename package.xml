<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 to serial drive-by-wire bridge for the real vehicle, plus the shared steering-relay controller tesla_sim uses to model the same hardware behavior in simulation.</description>
  <maintainer email="neelnaik2005@gmail.com">neel</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>pyserial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
